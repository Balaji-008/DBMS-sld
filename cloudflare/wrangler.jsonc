{
  "name": "campusbridge-dbms",
  "main": "worker.ts",
  "account_id": "b1e1983c78c805e6003f18ee813b2dbd",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
