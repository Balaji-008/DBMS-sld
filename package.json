{
  "name": "amrita-placement-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Amrita Bengaluru Placement Portal backed exclusively by Oracle Database",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts --host 127.0.0.1",
    "typecheck": "npm run typecheck:server && npm run typecheck:client",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "typecheck:client": "tsc -p client/tsconfig.json --noEmit",
    "build": "npm run typecheck && npm run build:client",
    "build:client": "vite build --config client/vite.config.ts",
    "start": "tsx server/src/index.ts",
    "start:background": "node scripts/service.mjs start",
    "services:install": "node scripts/install-user-services.mjs",
    "services:check": "node scripts/install-user-services.mjs --check",
    "stop": "node scripts/service.mjs stop",
    "status": "node scripts/service.mjs status",
    "db:provision": "node scripts/provision.mjs",
    "db:setup": "tsx scripts/database.ts",
    "smtp:configure": "node scripts/configure-smtp.mjs",
    "test:integration": "tsx tests/integration.ts",
    "test:browser": "tsx tests/browser.ts",
    "deploy:cloudflare": "node scripts/deploy.mjs",
    "tunnel:start": "node scripts/tunnel-service.mjs start",
    "tunnel:stop": "node scripts/tunnel-service.mjs stop",
    "tunnel:status": "node scripts/tunnel-service.mjs status",
    "assets:render": "python scripts/render-brand-assets.py",
    "test:brand-email": "tsx tests/brand-email.ts",
    "test:brand-browser": "tsx tests/brand-browser.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "oracledb": "^6.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/oracledb": "^6.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
